{
  "schema": "qcax.fabric.migration-waves/1",
  "waves": [
    {
      "name": "authority-base",
      "plugins": [
        "truth-policy",
        "canonical-identity",
        "provenance",
        "source-admission",
        "authorization"
      ],
      "rule": "SYSTEM_PINNED exact InstalledImageIdentity BootLock",
      "wave": 0
    },
    {
      "name": "developer-base",
      "plugins": [
        "prompt-hardener",
        "memory",
        "workgraph",
        "evaluation-redlab",
        "registry"
      ],
      "rule": "first-party independent packages, no host/sibling implementation imports",
      "wave": 1
    },
    {
      "name": "operational",
      "plugins": [
        "sandbox",
        "scheduler",
        "drive",
        "github",
        "release-supply-chain"
      ],
      "rule": "side-effect class + authorization/rollback receipts required",
      "wave": 2
    },
    {
      "name": "interop",
      "plugins": [
        "inspect-adapter",
        "cordis-adapter",
        "langgraph-adapter",
        "temporal-adapter",
        "acp-adapter"
      ],
      "rule": "pinned external versions + shared held-out conformance",
      "wave": 3
    },
    {
      "name": "profiles",
      "plugins": [
        "leadfinder",
        "research",
        "mathematics",
        "forecasting"
      ],
      "rule": "profile composition only; no cross-target execution credit",
      "wave": 4
    }
  ]
}
