{
  "bypass": "minimum administrators only; no routine bypass; every bypass requires issue/receipt",
  "main": {
    "bootstrap_approval_mode": "SOLO_MAINTAINER_SAFE_0_REQUIRED_APPROVALS",
    "enforcement_initial": "evaluate_then_active",
    "future_multi_maintainer_upgrade": "require >=1 approving review and code-owner review for TCB/contracts/release paths once a second eligible reviewer exists",
    "required_checks": [
      "ci / linux-py311",
      "ci / linux-py314",
      "ci / windows-py313",
      "ci / macos-py313",
      "conformance / installed-wheel",
      "conformance / import-boundary",
      "conformance / semantic-mutations",
      "security / dependency-review"
    ],
    "rules": [
      "block_deletions",
      "block_force_pushes",
      "require_pull_request",
      "require_conversation_resolution",
      "require_status_checks",
      "require_linear_history",
      "zero_required_approvals_while_solo",
      "CODEOWNERS_routes_ownership_but_is_not_independent_review"
    ],
    "target": "refs/heads/main"
  },
  "merge_queue": "NOT_APPLICABLE_PERSONAL_ACCOUNT_BASELINE",
  "owner_mode": "PERSONAL_USER_qcax",
  "release_tags": {
    "rules": [
      "restrict_updates",
      "restrict_deletions"
    ],
    "target": "refs/tags/v*"
  },
  "status": "PLANNED_NOT_APPLIED"
}
