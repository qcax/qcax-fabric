{
  "$id": "https://qcax.example/schema/release-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_set": {
      "type": "object"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "package_set": {
      "type": "object"
    },
    "publication_order": {
      "items": {
        "type": "string"
      },
      "minItems": 8,
      "type": "array"
    },
    "release_identity": {
      "required": [
        "status",
        "selected_version",
        "selected_tag"
      ],
      "type": "object"
    },
    "repository": {
      "type": "string"
    },
    "schema": {
      "const": "qcax.release-contract/2"
    },
    "source_binding": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "repository",
    "release_identity",
    "source_binding",
    "package_set",
    "artifact_set",
    "publication_order",
    "claim_ceiling"
  ],
  "type": "object"
}
