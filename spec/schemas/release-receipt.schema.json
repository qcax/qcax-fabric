{
  "$id": "https://qcax.example/schema/release-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact": {
      "type": "object"
    },
    "evidence": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "package_set_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "release_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": "string"
    },
    "schema": {
      "const": "qcax.release-receipt/2"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_tree": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "stage": {
      "enum": [
        "preflight",
        "github-publish",
        "replay",
        "pypi-precheck",
        "pypi-publish",
        "complete"
      ]
    },
    "workflow": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "stage",
    "repository",
    "source_commit",
    "source_tree",
    "package_set_digest",
    "evidence"
  ],
  "type": "object"
}
