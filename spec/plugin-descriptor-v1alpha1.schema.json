{
  "$defs": {
    "cap": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        "contract_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "contract_version"
      ],
      "type": "object"
    },
    "event": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "durability": {
          "enum": [
            "EPHEMERAL",
            "DURABLE"
          ]
        },
        "mode": {
          "enum": [
            "emit",
            "waterfall",
            "serial",
            "guard"
          ]
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mode",
        "durability",
        "contract_version"
      ],
      "type": "object"
    }
  },
  "$id": "urn:qcax:schema:plugin-descriptor:v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "side_effect_class": {
            "enum": [
              "LOCAL_REVERSIBLE",
              "EXTERNAL_MUTATION"
            ]
          }
        },
        "required": [
          "side_effect_class"
        ]
      },
      "then": {
        "properties": {
          "rollback_receipt_schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "api_version": {
      "const": "qcax.fabric/v1alpha1"
    },
    "config_schema": {
      "type": "string"
    },
    "distribution_name": {
      "type": "string"
    },
    "distribution_version": {
      "type": "string"
    },
    "events_consumed": {
      "items": {
        "$ref": "#/$defs/event"
      },
      "type": "array",
      "uniqueItems": true
    },
    "events_emitted": {
      "items": {
        "$ref": "#/$defs/event"
      },
      "type": "array",
      "uniqueItems": true
    },
    "execution_mode": {
      "enum": [
        "TRUSTED_IN_PROCESS",
        "SANDBOXED_PROCESS",
        "REMOTE"
      ]
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "plugin_class": {
      "enum": [
        "SYSTEM_PINNED",
        "FIRST_PARTY",
        "THIRD_PARTY",
        "ADAPTER",
        "PROFILE"
      ]
    },
    "plugin_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "plugin_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "type": "string"
    },
    "provides": {
      "items": {
        "$ref": "#/$defs/cap"
      },
      "type": "array",
      "uniqueItems": true
    },
    "requires": {
      "items": {
        "$ref": "#/$defs/cap"
      },
      "type": "array",
      "uniqueItems": true
    },
    "rollback_receipt_schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "qcax.plugin/v1alpha1"
    },
    "side_effect_class": {
      "enum": [
        "NONE",
        "READ_ONLY",
        "LOCAL_REVERSIBLE",
        "EXTERNAL_MUTATION"
      ]
    },
    "state_schema": {
      "type": "string"
    },
    "target_scopes": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "plugin_id",
    "plugin_version",
    "plugin_class",
    "api_version",
    "distribution_name",
    "distribution_version",
    "provides",
    "requires",
    "events_consumed",
    "events_emitted",
    "permissions",
    "target_scopes",
    "side_effect_class",
    "execution_mode",
    "config_schema",
    "state_schema",
    "rollback_receipt_schema"
  ],
  "title": "QCAX Plugin Descriptor v1alpha1",
  "type": "object"
}
